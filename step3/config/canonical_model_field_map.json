{
  "schema_version": 1,
  "principle": "Map only explicit static config fields, deterministic config defaults, and benchmark metadata; never infer from a model name.",
  "benchmark_precedence": {
    "architecture_family": "architecture",
    "total_params_billions": "total_params_billions",
    "activated_params_billions": "activated_params_billions",
    "weight_precision": "weight_precision"
  },
  "direct_config_fields": {
    "num_layers": "num_hidden_layers",
    "hidden_size": "hidden_size",
    "intermediate_size": "intermediate_size",
    "num_attention_heads": "num_attention_heads",
    "num_key_value_heads": "num_key_value_heads",
    "head_dim": "head_dim",
    "vocab_size": "vocab_size",
    "context_length": "max_position_embeddings",
    "expert_count": ["num_experts", "num_local_experts", "n_routed_experts"],
    "active_expert_count": ["num_experts_per_tok", "experts_per_token"],
    "moe_intermediate_size": "moe_intermediate_size",
    "shared_expert_count": "n_shared_experts",
    "shared_expert_intermediate_size": "shared_expert_intermediate_size"
  },
  "nested_text_config_models": ["gemma3"],
  "architecture_rules": {
    "Dense Transformer": "dense_transformer",
    "MoE": "mixture_of_experts",
    "Mamba-Transformer Hybrid": "hybrid_mamba_transformer"
  },
  "precision_bits": {"bfloat16": 16, "fp8": 8, "mxfp4": 4},
  "runtime_dtype_bits": {"bfloat16": 16, "float16": 16, "float32": 32, "float64": 64},
  "unsupported_physics_attention": ["mla", "hybrid"]
}
